# Copy to .env and fill in:   cp .env.example .env
# docker compose reads this file for ${VAR} substitution AND passes it to the api container.
# Never commit .env.

# ---------------------------------------------------------------- general
ENVIRONMENT=production

# ---------------------------------------------------------------- postgres (compose builds DATABASE_URL from these)
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app
# Overridden by docker-compose.yml for the api container; used as-is when running the backend
# outside compose (e.g. `alembic upgrade head` against a local Postgres).
DATABASE_URL=postgresql+asyncpg://app:change-me-postgres@localhost:5432/app
# Overridden by docker-compose.yml (redis://redis:6379/0).
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- backend session JWT
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_TTL_SECONDS=28800
JWT_ISSUER=pr-review-agent

# Fernet key for users.github_token_enc. MUST differ from JWT_SECRET.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   (or, without cryptography installed: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
TOKEN_ENCRYPTION_KEY=

# Shared secret between the Next.js server and FastAPI for POST /auth/github/exchange.
# Used by BOTH the frontend and api containers.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_BRIDGE_SECRET=

# ---------------------------------------------------------------- sign-in policy (fails closed)
# CSV. Role is derived from these at FIRST sign-in only; later changes go through /admin/users.
GITHUB_ADMIN_IDS=
GITHUB_REVIEWER_ORGS=
GITHUB_VIEWER_ORGS=

# ---------------------------------------------------------------- GitHub App (agent, read-only)
# App permissions: Contents: Read, Pull requests: Read, Metadata: Read. Nothing else.
GITHUB_APP_ID=
# PEM on ONE line with literal \n separators, single-quoted:
#   GITHUB_APP_PRIVATE_KEY='-----BEGIN RSA PRIVATE KEY-----\nMIIE...\n-----END RSA PRIVATE KEY-----\n'
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Dev fallback when no App is configured: a fine-grained, read-only token.
GITHUB_READONLY_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_FETCH_MAX_BYTES=200000

# ---------------------------------------------------------------- proxy trust
# Only these peers' X-Forwarded-For is believed. IPs or CIDRs. Default in compose is the
# container ip_range of the `app` network (172.28.1.0/24), which excludes the gateway.
TRUSTED_PROXIES=172.28.1.0/24

# ---------------------------------------------------------------- app-layer rate limits (Redis, per user)
RATE_LIMIT_GENERAL_PER_MINUTE=600
REVIEW_QUOTA_PER_HOUR_REVIEWER=20
REVIEW_QUOTA_PER_HOUR_ADMIN=100

# ---------------------------------------------------------------- LLM
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOOL_ROUNDS=12

# ---------------------------------------------------------------- Langfuse (self-hosted, infra/langfuse.sh)
# Create a project in the Langfuse UI (http://langfuse.localhost) and paste its keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# langfuse-web joins the app network (infra/langfuse.override.yml); no host port is published.
LANGFUSE_HOST=http://langfuse-web:3000
# Where browsers reach the Langfuse UI, through nginx (*.localhost resolves to loopback).
LANGFUSE_PUBLIC_URL=http://langfuse.localhost

# ---------------------------------------------------------------- frontend (Next.js / Auth.js v5)
# Generate: npx auth secret   (or python -c "import secrets; print(secrets.token_urlsafe(32))")
AUTH_SECRET=
# GitHub OAuth App. Callback URL: http://localhost/api/auth/callback/github
# Scopes requested: read:user user:email read:org   (never `repo` — it is read-write)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Server-to-server address of the API (never through nginx).
API_INTERNAL_URL=http://api:8000
AUTH_URL=http://localhost
AUTH_TRUST_HOST=true
