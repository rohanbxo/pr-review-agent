# Auth.js v5 ------------------------------------------------------------------
# openssl rand -base64 33
AUTH_SECRET=change-me
# GitHub OAuth App (scopes requested: read:user user:email read:org — never `repo`).
# Callback URL: http://localhost/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Behind nginx the Host header is trusted (also set in code via trustHost).
AUTH_TRUST_HOST=true
# Public origin, used for OAuth redirects when behind the proxy.
AUTH_URL=http://localhost

# Backend bridge ---------------------------------------------------------------
# Server-to-server base URL of FastAPI (no /api prefix; that is nginx's).
API_INTERNAL_URL=http://api:8000
# Must equal the backend's AUTH_BRIDGE_SECRET.
AUTH_BRIDGE_SECRET=change-me
